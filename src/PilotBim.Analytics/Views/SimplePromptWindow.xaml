<Window x:Class="PilotBim.Analytics.Views.SimplePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:PilotBim.Analytics.Properties"
        Title="PilotBim.Analytics"
        Height="160" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F5"
        Foreground="#1F2A24">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="PromptText" Text="{x:Static props:Resources.Common_NameLabel}" Margin="0,0,0,8" TextWrapping="Wrap" />
    <TextBox x:Name="ValueBox" Grid.Row="1" Height="28" Padding="4,2" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static props:Resources.Common_Cancel}" Width="90" Height="28" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
              Background="#E8E8E4" Foreground="#1F2A24" BorderBrush="#C8C8C0" />
      <Button Content="{x:Static props:Resources.Common_OK}" Width="90" Height="28" IsDefault="True" Click="Ok_Click"
              Background="#1F2A24" Foreground="White" BorderBrush="#1F2A24" />
    </StackPanel>
  </Grid>
</Window>
