<Window x:Class="PilotBim.Analytics.Views.DashboardQueryWidgetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PilotBim.Analytics.Views"
        xmlns:props="clr-namespace:PilotBim.Analytics.Properties"
        Title="{x:Static props:Resources.QueryEditor_WindowTitle}"
        MinWidth="960" MinHeight="680"
        Width="1020" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F7F7F5"
        Foreground="#1F2A24">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" MinWidth="420" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="0.8*" MinWidth="280" />
      </Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="{x:Static props:Resources.QueryEditor_DataHeader}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_ScopeLabel}" Margin="0,0,0,4" />
          <TextBox Text="{Binding ScopeDisplay, Mode=OneWay}" IsReadOnly="True" Height="28" Margin="0,0,0,12" Padding="4,2"
                   Background="#EFEFEA" BorderBrush="#C8C8C0" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_TypeLabel}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                    DisplayMemberPath="Label" Height="28" Margin="0,0,0,4" />
          <TextBlock Text="{x:Static props:Resources.QueryEditor_TypeChangeHint}" TextWrapping="Wrap"
                     Foreground="#5A645E" FontSize="11" Margin="0,0,0,12" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_FiltersHeader}" Margin="0,0,0,6" />
          <ItemsControl ItemsSource="{Binding FilterRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="32" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" ItemsSource="{Binding FieldChoices}" SelectedItem="{Binding SelectedField}"
                            DisplayMemberPath="Label" Height="28" />
                  <ComboBox Grid.Column="2" ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"
                            DisplayMemberPath="Title" Height="28" />
                  <Grid Grid.Column="4">
                    <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="4,2"
                             Visibility="{Binding ShowTextValue, Converter={StaticResource BoolToVis}}" />
                    <ComboBox ItemsSource="{Binding BooleanChoices}" SelectedItem="{Binding SelectedBoolean}"
                              DisplayMemberPath="Title" Height="28"
                              Visibility="{Binding ShowBooleanValue, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                  <Button Grid.Column="6" Content="{x:Static props:Resources.QueryEditor_RemoveFilter}"
                          Click="RemoveFilter_Click" Tag="{Binding}"
                          Width="32" Height="28" Background="#E8E8E4" Foreground="#1F2A24" BorderBrush="#C8C8C0"
                          ToolTip="{x:Static props:Resources.Common_Delete}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{x:Static props:Resources.QueryEditor_AddFilter}" Click="AddFilter_Click"
                  HorizontalAlignment="Left" Height="28" Margin="0,0,0,12" Padding="10,0"
                  Background="#E8E8E4" Foreground="#1F2A24" BorderBrush="#C8C8C0" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_MeasureLabel}" Margin="0,0,0,4" />
          <TextBox Text="{Binding MeasureDisplay, Mode=OneWay}" IsReadOnly="True" Height="28" Margin="0,0,0,12" Padding="4,2"
                   Background="#EFEFEA" BorderBrush="#C8C8C0" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_GroupByLabel}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding GroupByFields}" SelectedItem="{Binding SelectedDimension}"
                    DisplayMemberPath="Label" Height="28" Margin="0,0,0,12" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_SortLabel}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}"
                    DisplayMemberPath="Title" Height="28" Margin="0,0,0,12" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_TopNLabel}" Margin="0,0,0,4" />
          <TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,12" Padding="4,2" />

          <TextBlock Text="{x:Static props:Resources.QueryEditor_VisualizationHeader}" FontWeight="SemiBold" Margin="0,4,0,8" />
          <ComboBox ItemsSource="{Binding VisualizationChoices}" SelectedItem="{Binding SelectedVisualization}"
                    DisplayMemberPath="Title" Height="28" Margin="0,0,0,6" />
          <TextBlock Text="{x:Static props:Resources.QueryEditor_AutoHint}" TextWrapping="Wrap" Foreground="#5A645E" FontSize="11"
                     Visibility="{Binding ShowAutoHint, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding PreviewAutoResolved}" TextWrapping="Wrap" Foreground="#1F2A24" FontSize="11" Margin="0,4,0,0"
                     Visibility="{Binding ShowPreviewAutoResolved, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="2" Background="#EFEFEA" BorderBrush="#D8D8D0" BorderThickness="1" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static props:Resources.QueryEditor_PreviewHeader}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Top" Content="{x:Static props:Resources.QueryEditor_Preview}" Height="28" Margin="0,0,0,10"
                    Click="Preview_Click" HorizontalAlignment="Left" Padding="12,0"
                    Background="#1F2A24" Foreground="White" BorderBrush="#1F2A24" />
            <Grid>
              <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" Foreground="#5A645E"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding PreviewShowMessage, Converter={StaticResource BoolToVis}}" />
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="8"
                       Visibility="{Binding PreviewShowKpi, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding PreviewKpiValue}" FontSize="56" FontWeight="SemiBold" Foreground="#1F2A24" />
              </Viewbox>
              <DataGrid ItemsSource="{Binding PreviewTableRows}"
                        Visibility="{Binding PreviewShowTableScalar, Converter={StaticResource BoolToVis}}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="White" Foreground="#1F2A24" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{x:Static props:Resources.QueryTable_Indicator}" Binding="{Binding Category}" Width="2*" />
                  <DataGridTextColumn Header="{x:Static props:Resources.Column_Value}" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <DataGrid ItemsSource="{Binding PreviewTableRows}"
                        Visibility="{Binding PreviewShowTableGrouped, Converter={StaticResource BoolToVis}}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        Background="White" Foreground="#1F2A24" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{x:Static props:Resources.QueryTable_Category}" Binding="{Binding Category}" Width="2*" />
                  <DataGridTextColumn Header="{x:Static props:Resources.QueryTable_Count}" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <DockPanel Visibility="{Binding PreviewShowChart, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewWarning}" TextWrapping="Wrap"
                           Foreground="#8A6A1F" FontSize="11" Margin="0,0,0,6"
                           Visibility="{Binding ShowPreviewWarning, Converter={StaticResource BoolToVis}}" />
                <views:ChartCanvasControl
                          ChartKind="{Binding PreviewChartKind}"
                          Points="{Binding PreviewPoints}"
                          MinHeight="180"
                          VerticalAlignment="Stretch" />
              </DockPanel>
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding ValidationMessage}" Foreground="#A33" Margin="0,10,0,8" TextWrapping="Wrap" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{x:Static props:Resources.QueryEditor_TitleLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,16,0" Padding="4,2" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="{x:Static props:Resources.Common_Cancel}" Width="100" Height="30" Margin="0,0,8,0"
                IsCancel="True" Click="Cancel_Click" Background="#E8E8E4" Foreground="#1F2A24" BorderBrush="#C8C8C0" />
        <Button Content="{x:Static props:Resources.QueryEditor_Save}" Width="110" Height="30" IsDefault="True"
                Click="Save_Click" IsEnabled="{Binding IsValid}"
                Background="#1F2A24" Foreground="White" BorderBrush="#1F2A24" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
