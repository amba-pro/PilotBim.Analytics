<Window x:Class="PilotBim.Analytics.Views.DashboardFilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:PilotBim.Analytics.Properties"
        Title="{x:Static props:Resources.DashboardFilters_WindowTitle}"
        Width="520" Height="640"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F7F7F5"
        Foreground="#1F2A24">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{x:Static props:Resources.DashboardFilters_Title}" Margin="0,0,0,4" />
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,12" Padding="4,2" />

        <TextBlock Text="{x:Static props:Resources.DashboardFilters_Type}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                  DisplayMemberPath="Label" Height="28" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static props:Resources.DashboardFilters_Field}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}"
                  DisplayMemberPath="Label" Height="28" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static props:Resources.DashboardFilters_Operator}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"
                  DisplayMemberPath="Title" Height="28" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static props:Resources.DashboardFilters_Value}" Margin="0,0,0,4"
                   Visibility="{Binding NeedsValue, Converter={StaticResource BoolToVis}}" />
        <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,0,0,4" Padding="4,2"
                 Visibility="{Binding ShowTextValue, Converter={StaticResource BoolToVis}}" />
        <ComboBox ItemsSource="{Binding BooleanChoices}" SelectedItem="{Binding SelectedBoolean}"
                  DisplayMemberPath="Title" Height="28" Margin="0,0,0,4"
                  Visibility="{Binding ShowBooleanValue, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{x:Static props:Resources.QueryEditor_StableKeyHint}" TextWrapping="Wrap"
                   Foreground="#5A645E" FontSize="11" Margin="0,0,0,12"
                   Visibility="{Binding ShowStableKeyHint, Converter={StaticResource BoolToVis}}" />

        <CheckBox Content="{x:Static props:Resources.DashboardFilters_Enabled}" IsChecked="{Binding Enabled}"
                  Margin="0,0,0,12" Foreground="#1F2A24" />

        <TextBlock Text="{x:Static props:Resources.DashboardFilters_ApplyTo}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{x:Static props:Resources.DashboardFilters_NoCompatibleWidgets}" TextWrapping="Wrap"
                   Foreground="#5A645E" Margin="0,0,0,8"
                   Visibility="{Binding ShowNoCompatibleWidgets, Converter={StaticResource BoolToVis}}" />
        <ItemsControl ItemsSource="{Binding Targets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        Margin="0,0,0,6" Foreground="#1F2A24" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="1" Text="{Binding ValidationMessage}" Foreground="#A33" Margin="0,10,0,8" TextWrapping="Wrap" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static props:Resources.Common_Cancel}" Width="100" Height="30" Margin="0,0,8,0"
              IsCancel="True" Click="Cancel_Click" Background="#E8E8E4" Foreground="#1F2A24" BorderBrush="#C8C8C0" />
      <Button Content="{x:Static props:Resources.QueryEditor_Save}" Width="110" Height="30"
              IsDefault="True" Click="Save_Click" Background="#1F2A24" Foreground="White" BorderBrush="#1F2A24"
              IsEnabled="{Binding IsValid}" />
    </StackPanel>
  </Grid>
</Window>
