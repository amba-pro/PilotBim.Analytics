<Window x:Class="PilotBim.Analytics.Views.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilot-BIM Analytics — Обзор проекта"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F5"
        Foreground="#1F2A24">
  <Window.Resources>
    <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#1F2A24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="13" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1F2A24" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#D8DDD9" />
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsSelected" Value="True" />
            <Condition Property="IsMouseOver" Value="True" />
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="#2A3A32" />
          <Setter Property="Foreground" Value="White" />
        </MultiTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AnalyticsDataGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#1F2A24" />
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="AlternatingRowBackground" Value="#F3F5F4" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E0E4E2" />
      <Setter Property="VerticalGridLinesBrush" Value="#E0E4E2" />
      <Setter Property="BorderBrush" Value="#C8CECB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="CellStyle">
        <Setter.Value>
          <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F2A24" />
            <Setter Property="BorderBrush" Value="#E0E4E2" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#D4E4DA" />
                <Setter Property="Foreground" Value="#1F2A24" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="RowStyle">
        <Setter.Value>
          <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#1F2A24" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
              <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#F3F5F4" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#D4E4DA" />
                <Setter Property="Foreground" Value="#1F2A24" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AnalyticsDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#ECECE8" />
      <Setter Property="Foreground" Value="#1F2A24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="#C8CECB" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style x:Key="AnalyticsDataGridCell" TargetType="TextBlock">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Foreground" Value="#1F2A24" />
    </Style>
    <DataTemplate x:Key="ChartBarTemplate">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                   VerticalAlignment="Center" Foreground="#1F2A24" FontSize="12" />
        <Grid Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
          <Border Background="#E8ECE9" Height="20" CornerRadius="2" />
          <Border Background="#3A7D5C" Height="20" CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" />
        </Grid>
        <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Foreground="#1F2A24" FontSize="12" />
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1F2A24" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical">
          <TextBlock Text="Pilot-BIM Analytics — Обзор проекта" Foreground="White" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding HeaderSubtitle}" Foreground="#C8D4CE" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton Content="Быстро" GroupName="AnalyticsScanMode" IsChecked="{Binding IsFast}" Foreground="White" Margin="0,0,10,0" />
          <RadioButton Content="Стандарт" GroupName="AnalyticsScanMode" IsChecked="{Binding IsStandard}" Foreground="White" Margin="0,0,10,0" />
          <RadioButton Content="Полный" GroupName="AnalyticsScanMode" IsChecked="{Binding IsFull}" Foreground="White" Margin="0,0,14,0" />
          <Button Content="Обновить" Width="100" Height="28" Margin="0,0,8,0" Click="Refresh_Click" />
          <Button Content="Экспорт CSV" Width="100" Height="28" Margin="0,0,8,0" Click="ExportCsv_Click" />
          <Button Content="Отмена" Width="80" Height="28" Click="Cancel_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#E8E8E4">
      <TextBlock Text="{Binding ProgressText}" Foreground="#1F2A24" Margin="8,0" />
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0"
               ItemsSource="{Binding Navigation}"
               SelectedValuePath="Key"
               SelectedValue="{Binding SelectedNavKey}"
               BorderThickness="0"
               Background="#ECECE8"
               ItemContainerStyle="{StaticResource NavListBoxItem}"
               SelectionChanged="Nav_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Title}" FontSize="13">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="#1F2A24" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Column="1" Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding SelectedNavTitle}" FontSize="20" FontWeight="SemiBold"
                   Foreground="#1F2A24" Margin="0,0,0,10" />

        <StackPanel x:Name="BimFilterBar" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
          <TextBlock Text="Модель:" VerticalAlignment="Center" Foreground="#1F2A24" Margin="0,0,8,0" />
          <ComboBox Width="320" ItemsSource="{Binding BimModelFilters}"
                    SelectedItem="{Binding SelectedBimModelFilter}"
                    DisplayMemberPath="DisplayName" />
        </StackPanel>

        <ScrollViewer x:Name="PanelSummary" Grid.Row="2" Visibility="Visible">
          <DataGrid ItemsSource="{Binding Summary}"
                    Style="{StaticResource AnalyticsDataGrid}"
                    ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                    AutoGenerateColumns="False" IsReadOnly="True" Height="280">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Показатель" Binding="{Binding Label}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
              <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
              <DataGridTextColumn Header="Детали" Binding="{Binding Detail}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            </DataGrid.Columns>
          </DataGrid>
        </ScrollViewer>

        <ScrollViewer x:Name="PanelCharts" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <TabControl Background="White" Foreground="#1F2A24">
            <TabItem Header="Типы (top)">
              <ItemsControl ItemsSource="{Binding ChartTypesTop}" ItemTemplate="{StaticResource ChartBarTemplate}" Margin="8" />
            </TabItem>
            <TabItem Header="Создатели">
              <ItemsControl ItemsSource="{Binding ChartCreatorsTop}" ItemTemplate="{StaticResource ChartBarTemplate}" Margin="8" />
            </TabItem>
            <TabItem Header="Динамика создания">
              <ItemsControl ItemsSource="{Binding ChartCreatedTimeline}" ItemTemplate="{StaticResource ChartBarTemplate}" Margin="8" />
            </TabItem>
            <TabItem Header="IFC типы">
              <ItemsControl ItemsSource="{Binding ChartIfcTypesTop}" ItemTemplate="{StaticResource ChartBarTemplate}" Margin="8" />
            </TabItem>
            <TabItem Header="OPEN/CLOSED">
              <ItemsControl ItemsSource="{Binding ChartStateSemantic}" ItemTemplate="{StaticResource ChartBarTemplate}" Margin="8" />
            </TabItem>
            <TabItem Header="Ответственные">
              <ItemsControl ItemsSource="{Binding ChartResponsibleTop}" ItemTemplate="{StaticResource ChartBarTemplate}" Margin="8" />
            </TabItem>
          </TabControl>
        </ScrollViewer>

        <DataGrid x:Name="PanelTypes" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding ObjectsByType}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="TypeId" Binding="{Binding TypeId}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Кол-во" Binding="{Binding CountDisplay}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Доля %" Binding="{Binding SharePercent, StringFormat={}{0:0.0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Fill %" Binding="{Binding FillPercent, StringFormat={}{0:0.0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelCreators" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding ObjectsByCreator}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Создатель" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="PersonId" Binding="{Binding CreatorId}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="В сэмпле" Binding="{Binding SampledCount}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Доля %" Binding="{Binding SharePercent, StringFormat={}{0:0.0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Охват" Binding="{Binding Scope}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelCreated" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding ObjectsByCreatedMonth}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Месяц" Binding="{Binding Period}" Width="120" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Создано" Binding="{Binding Count}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Доля %" Binding="{Binding SharePercent, StringFormat={}{0:0.0}}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelStates" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding ObjectsByUserState}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Статус" Binding="{Binding StateTitle}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="StateId" Binding="{Binding StateId}" Width="220" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="В сэмпле" Binding="{Binding Count}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Доля %" Binding="{Binding SharePercent, StringFormat={}{0:0.0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Охват" Binding="{Binding Scope}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelDocuments" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding DocumentVersions}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Объект" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Файлов" Binding="{Binding FileCount}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Пред. версий" Binding="{Binding PreviousSnapshotCount}" Width="90" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Итераций" Binding="{Binding TotalIterations}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelBim" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding BimSummary}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Показатель" Binding="{Binding Label}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Детали" Binding="{Binding Detail}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelBimModels" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding BimModelAnalytics}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="ModelId" Binding="{Binding ModelId}" Width="220" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Частей" Binding="{Binding PartCount}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Элементов" Binding="{Binding ElementCountDisplay}" Width="90" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="GlobalId" Binding="{Binding GlobalIdCount}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="GlobalId %" Binding="{Binding GlobalIdFillPercent, StringFormat={}{0:0.0}}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelBimParts" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding BimPartAnalytics}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Часть" Binding="{Binding PartName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="PartId" Binding="{Binding PartId}" Width="220" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Элементов" Binding="{Binding ElementCountDisplay}" Width="90" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="GlobalId" Binding="{Binding GlobalIdCount}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Без GlobalId" Binding="{Binding WithoutGlobalIdCount}" Width="90" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="GlobalId %" Binding="{Binding GlobalIdFillPercent, StringFormat={}{0:0.0}}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Источник" Binding="{Binding DataSource}" Width="120" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelBimTypes" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding BimElementTypeCounts}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="IFC тип" Binding="{Binding IfcType}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Модель" Binding="{Binding ModelName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Часть" Binding="{Binding PartName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Доля %" Binding="{Binding SharePercent, StringFormat={}{0:0.0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelQuality" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding DataQuality}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Атрибут" Binding="{Binding AttributeTitle}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Обяз." Binding="{Binding IsObligatory}" Width="50" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Fill %" Binding="{Binding FillRate, StringFormat={}{0:P0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Сэмпл" Binding="{Binding SampledCount}" Width="60" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelRemarks" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding ModelRemarks}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Тип замечания" Binding="{Binding TypeName}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Объектов" Binding="{Binding ObjectCount}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="bimObjectId fill" Binding="{Binding BimObjectIdFillRate, StringFormat={}{0:P0}}" Width="110" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Mapping" Binding="{Binding MappingStatus}" Width="120" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelRemarkLinks" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding RemarkLinks}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Объект" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="bimObjectId" Binding="{Binding BimObjectId}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Index" Binding="{Binding ResolvedInIndex}" Width="60" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Mapping" Binding="{Binding MappingStatus}" Width="100" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelResponsible" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding ObjectsByResponsible}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="OrgUnit / должность" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="OrgUnitId" Binding="{Binding OrgUnitId}" Width="90" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="В сэмпле" Binding="{Binding SampledCount}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Доля %" Binding="{Binding SharePercent, StringFormat={}{0:0.0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Охват" Binding="{Binding Scope}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="PanelStateSemantic" Grid.Row="2" Visibility="Collapsed"
                  Style="{StaticResource AnalyticsDataGrid}"
                  ColumnHeaderStyle="{StaticResource AnalyticsDataGridColumnHeader}"
                  ItemsSource="{Binding ObjectsByUserStateSemantic}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Семантика" Binding="{Binding Semantic}" Width="120" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Пример статуса" Binding="{Binding StateTitle}" Width="2*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="В сэмпле" Binding="{Binding Count}" Width="80" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Доля %" Binding="{Binding SharePercent, StringFormat={}{0:0.0}}" Width="70" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
            <DataGridTextColumn Header="Охват" Binding="{Binding Scope}" Width="*" ElementStyle="{StaticResource AnalyticsDataGridCell}" />
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" Background="#EEECE6" CornerRadius="4">
          <StackPanel>
            <TextBlock Text="Ограничения (read-only)" FontWeight="SemiBold" Foreground="#1F2A24" Margin="0,0,0,6" />
            <TextBlock Text="{Binding LimitationsText}" TextWrapping="Wrap" FontSize="12" Foreground="#444" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
